# controlU FastAPI Backend Environment Configuration

# App environment mode
DEBUG=True

# DATABASE_URL: Put your Supabase Postgres connection string here.
# SQLAlchemy needs a 'postgresql://' connection string (which the app automatically maps to asyncpg compatible).
# Example: postgresql://postgres:YOUR_PASSWORD@db.YOUR_SUPABASE_PROJECT_ID.supabase.co:5432/postgres
DATABASE_URL=sqlite+aiosqlite:///./controlu.db

# JWT Configuration
# Change this to a secure random key for production
JWT_SECRET_KEY=SUPER_SECRET_AURA_KEY_DO_NOT_USE_IN_PRODUCTION_1234567890
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# controlU FastAPI Backend Environment Configuration

# App environment mode (set to False in production)
DEBUG=True

# DATABASE_URL: Put your database connection string here.
# Local Development SQLite Default: sqlite+aiosqlite:///./controlu.db
# Production Supabase PostgreSQL: postgresql://postgres:YOUR_PASSWORD@db.YOUR_SUPABASE_PROJECT_ID.supabase.co:5432/postgres
DATABASE_URL=sqlite+aiosqlite:///./controlu.db

# JWT Security Configuration
# Change this to a secure random key for production!
JWT_SECRET_KEY=SUPER_SECRET_AURA_KEY_DO_NOT_USE_IN_PRODUCTION_1234567890
ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_ALGORITHM=HS256

# CORS Configuration
# Comma-separated list of allowed origin domains for local and production deployment
# Example: http://localhost:3000,https://controlu.vercel.app
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

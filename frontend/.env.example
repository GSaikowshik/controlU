# controlU React Frontend Environment Configuration

# VITE_API_URL: The URL targeting your FastAPI backend server.
# For local development with Vite server proxy (defined in vite.config.js):
# Leave this blank or set to 'http://localhost:3000' (Vite's port) to route requests via Vite's proxy.
# E.g. VITE_API_URL=http://localhost:3000
# For production deployment:
# Set this to your live backend Render/Heroku API URL.
# E.g. VITE_API_URL=https://controlu-backend.onrender.com
VITE_API_URL=http://localhost:3000

# Supabase Auth Configuration
# Required for Google Sign-In and OAuth flows.
# Get these from your Supabase Project Settings -> API page.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
